<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLPerformanceVisualizer.ViewModels"
        xmlns:m="using:SQLPerformanceVisualizer.Models"
        xmlns:converters="using:SQLPerformanceVisualizer.Converters"
        xmlns:controls="using:SQLPerformanceVisualizer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="780"
        x:Class="SQLPerformanceVisualizer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SQL Performance Visualizer — ronald.de.groot@opendata.nl"
        Width="1300" Height="780"
        MinWidth="900" MinHeight="500">

    <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="8">

        <!-- ROW 0: Single-line top bar — connect + database picker -->
        <Border Grid.Row="0" Background="#2D2D2D" CornerRadius="4" Padding="10,7">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                <TextBlock Text="SQL Server:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ConnectVm.ServerName}"
                         PlaceholderText="localhost"
                         Width="180"
                         Background="#3C3C3C" Foreground="White"
                         VerticalAlignment="Center"/>

                <!-- Connection status indicator -->
                <Ellipse Width="10" Height="10" Fill="#CC3333" VerticalAlignment="Center"
                         IsVisible="{Binding ConnectVm.IsConnected, Converter={x:Static BoolConverters.Not}}"/>
                <Ellipse Width="10" Height="10" Fill="#33BB33" VerticalAlignment="Center"
                         IsVisible="{Binding ConnectVm.IsConnected}"/>

                <Button Content="Connect"
                        Command="{Binding ConnectVm.ConnectCommand}"
                        IsEnabled="{Binding !ConnectVm.IsConnecting}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding ConnectVm.ErrorMessage}"/>

                <Rectangle Width="1" Height="20" Fill="#555" VerticalAlignment="Center" Margin="4,0"/>

                <TextBlock Text="Database:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding DatabaseListVm.Databases}"
                          SelectedItem="{Binding DatabaseListVm.SelectedDatabase}"
                          MinWidth="200" MaxWidth="360"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:DatabaseInfo">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Loading…" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                           IsVisible="{Binding DatabaseListVm.IsLoading}"/>
                <TextBlock Text="{Binding DatabaseListVm.ErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                           VerticalAlignment="Center"
                           IsVisible="{Binding DatabaseListVm.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            </StackPanel>
        </Border>

        <!-- ROW 1: Tabbed content -->
        <TabControl Grid.Row="1">

            <!-- Tab: Tables (Tables + Columns side by side) -->
            <TabItem Header="Tables">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">

                    <!-- Panel: Tables -->
                    <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding TableListVm}" x:DataType="vm:TableListViewModel">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                <TextBlock Text="Tables" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <TextBlock Text="Loading…" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                                           IsVisible="{Binding IsLoading}"/>
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,65,65,65" ColumnSpacing="6" Margin="8,0,0,2">
                                <TextBlock Grid.Column="0" Text="Table"      Foreground="#888" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="Rows"       Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Data (MB)"  Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Index (MB)" Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <ListBox ItemsSource="{Binding Tables}"
                                     SelectedItem="{Binding SelectedTable}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:TableInfo">
                                        <Grid ColumnDefinitions="*,65,65,65" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" Text="{Binding FullName}"        FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RowCountDisplay}"  FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DataSizeDisplay}"  FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding IndexSizeDisplay}" FontSize="12" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Panel: Columns (ListBox with highlight support) -->
                    <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding ColumnListVm}" x:DataType="vm:ColumnListViewModel">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <TextBlock Text="Columns" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <TextBlock Text="Loading…" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                                           IsVisible="{Binding IsLoading}"/>
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,75,45" Margin="8,0,0,2">
                                <TextBlock Grid.Column="0" Text="Column" Foreground="#888" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="Type"   Foreground="#888" FontSize="10"/>
                                <TextBlock Grid.Column="2" Text="Null"   Foreground="#888" FontSize="10"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding Columns}"
                                     SelectedItem="{Binding SelectedColumn}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="4,1"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColumnRow">
                                        <Border Background="{Binding IsHighlighted,
                                                    Converter={x:Static converters:HighlightBrushConverter.Instance}}"
                                                HorizontalAlignment="Stretch"
                                                Padding="0,1">
                                            <Grid ColumnDefinitions="*,75,45">
                                                <TextBlock Grid.Column="0" Text="{Binding Info.ColumnName}" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Info.DataTypeDisplay}" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Info.IsNullableDisplay}" FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- Tab: Indexes -->
            <TabItem Header="Indexes">
                <Border Background="#2D2D2D" CornerRadius="4" Padding="8" Margin="0,8,0,0"
                        DataContext="{Binding IndexListVm}" x:DataType="vm:IndexListViewModel">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                            <TextBlock Text="Indexes" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            <TextBlock Text="Loading…" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                                       IsVisible="{Binding IsLoading}"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <DataGrid Name="IndexesDataGrid"
                                  ItemsSource="{Binding Indexes}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn     Header="Index Name"  Binding="{Binding Info.IndexName}"        Width="*"/>
                                <DataGridTemplateColumn Header="" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:IndexRow">
                                            <Grid ColumnDefinitions="Auto,Auto">
                                                <Button Grid.Column="0" Content="Rebuild" FontSize="10" Padding="6,2"
                                                        IsEnabled="{Binding !IsBusy}"
                                                        Command="{Binding #IndexesDataGrid.((vm:IndexListViewModel)DataContext).RebuildCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#E04040" Margin="4,0,0,0"
                                                         VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:IndexRow">
                                            <Grid ColumnDefinitions="Auto,Auto">
                                                <Button Grid.Column="0" Content="Reorganize" FontSize="10" Padding="6,2"
                                                        IsEnabled="{Binding !IsBusy}"
                                                        Command="{Binding #IndexesDataGrid.((vm:IndexListViewModel)DataContext).ReorganizeCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#E04040" Margin="4,0,0,0"
                                                         VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn     Header="Type"          Binding="{Binding Info.IndexTypeDisplay}"     Width="100"/>
                                <DataGridTextColumn     Header="Pages"         Binding="{Binding Info.PagesDisplay}"         Width="80"/>
                                <DataGridTextColumn     Header="Size (MB)"     Binding="{Binding Info.SizeMBDisplay}"        Width="80"/>
                                <DataGridTextColumn     Header="Fragmentation %" Binding="{Binding Info.FragmentationDisplay}" Width="110"/>
                                <DataGridCheckBoxColumn Header="Unique"        Binding="{Binding Info.IsUnique}"             Width="55"/>
                                <DataGridCheckBoxColumn Header="PK"            Binding="{Binding Info.IsPrimaryKey}"         Width="40"/>
                                <DataGridTextColumn     Header="Key Columns"   Binding="{Binding Info.KeyColumns}"           Width="*"/>
                                <DataGridTextColumn     Header="Included"      Binding="{Binding Info.IncludedColumns}"      Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Tab: Statistics -->
            <TabItem Header="Statistics">
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="8" Margin="0,8,0,0">

                    <!-- Panel: Statistics list -->
                    <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding StatisticsVm}" x:DataType="vm:StatisticsViewModel">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                <TextBlock Text="Statistics" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <TextBlock Text="Loading…" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                                           IsVisible="{Binding IsLoading}"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Statistics}"
                                      SelectedItem="{Binding SelectedStatistic}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="24">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:StatisticRow">
                                                <Ellipse Width="8" Height="8" Fill="#E04040"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         IsVisible="{Binding IsJustUpdated}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Stat Name"    Binding="{Binding Info.StatName}"              Width="*"/>
                                    <DataGridTextColumn Header="Last Updated" Binding="{Binding Info.LastUpdated}"           Width="130"/>
                                    <DataGridTextColumn Header="Sampled %"    Binding="{Binding Info.SamplingPercentText}"   Width="75"/>
                                    <DataGridTextColumn Header="Mod Count"    Binding="{Binding Info.ModificationCounter}"   Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Panel: Statistic detail (DBCC SHOW_STATISTICS: header, density vector, histogram) -->
                    <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding StatisticDetailVm}" x:DataType="vm:StatisticDetailViewModel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Statistic Detail" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    <TextBlock Text="Loading…" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                                               IsVisible="{Binding IsLoading}"/>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <Button Name="UpdateStatsButton" Grid.Column="1" Content="Update Stats"
                                        Command="{Binding OpenUpdatePopupCommand}"
                                        IsEnabled="{Binding CommandText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Popup IsOpen="{Binding IsUpdatePopupOpen}" PlacementTarget="{Binding #UpdateStatsButton}"
                                       Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
                                    <Border Background="#3C3C3C" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="8" Width="260">
                                            <TextBlock Text="Update Statistics" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                            <TextBlock Text="{Binding UpdatePreviewText}" FontFamily="Consolas,monospace"
                                                       Foreground="#CE9178" FontSize="11" TextWrapping="Wrap"/>
                                            <RadioButton GroupName="UpdateMode" Content="Sample percent" IsChecked="{Binding UseSamplePercent}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,0,0,0"
                                                        IsEnabled="{Binding UseSamplePercent}">
                                                <TextBox Text="{Binding SamplePercentInput}" Width="60"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            </StackPanel>
                                            <RadioButton GroupName="UpdateMode" Content="Full scan" IsChecked="{Binding UseFullScan}"/>
                                            <TextBlock Text="{Binding UpdateErrorMessage}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"
                                                       IsVisible="{Binding UpdateErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Command="{Binding CancelUpdateCommand}"/>
                                                <Button Content="Run" Command="{Binding RunUpdateStatisticsCommand}" IsEnabled="{Binding !IsUpdating}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock DockPanel.Dock="Top" Text="{Binding CommandText}" FontFamily="Consolas,monospace"
                                       Foreground="#CE9178" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock DockPanel.Dock="Top" Text="Stat Header" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <DataGrid DockPanel.Dock="Top" Height="70"
                                      ItemsSource="{Binding HeaderRow}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      FontSize="11" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rows"             Binding="{Binding Rows}"                  Width="70"/>
                                    <DataGridTextColumn Header="Rows Sampled"     Binding="{Binding RowsSampled}"           Width="90"/>
                                    <DataGridTextColumn Header="Steps"            Binding="{Binding Steps}"                 Width="50"/>
                                    <DataGridTextColumn Header="Density"          Binding="{Binding DensityDisplay}"        Width="80"/>
                                    <DataGridTextColumn Header="Avg Key Len"      Binding="{Binding AverageKeyLengthDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="String Idx"       Binding="{Binding StringIndex}"           Width="70"/>
                                    <DataGridTextColumn Header="Unfiltered Rows"  Binding="{Binding UnfilteredRows}"        Width="100"/>
                                    <DataGridTextColumn Header="Filter Expression" Binding="{Binding FilterExpression}"     Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock DockPanel.Dock="Top" Text="Density Vector" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <DataGrid DockPanel.Dock="Top" Height="90"
                                      ItemsSource="{Binding DensityVectors}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      FontSize="11" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="All Density" Binding="{Binding AllDensityDisplay}"  Width="100"/>
                                    <DataGridTextColumn Header="Avg Length"  Binding="{Binding AverageLengthDisplay}" Width="90"/>
                                    <DataGridTextColumn Header="Columns"     Binding="{Binding Columns}"           Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock DockPanel.Dock="Top" Text="Histogram" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <DataGrid ItemsSource="{Binding HistogramSteps}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Range Hi Key"        Binding="{Binding RangeHiKey}"               Width="*"/>
                                    <DataGridTextColumn Header="Range Rows"          Binding="{Binding RangeRowsDisplay}"          Width="90"/>
                                    <DataGridTextColumn Header="Eq Rows"             Binding="{Binding EqRowsDisplay}"             Width="80"/>
                                    <DataGridTextColumn Header="Distinct Range Rows" Binding="{Binding DistinctRangeRowsDisplay}"  Width="120"/>
                                    <DataGridTextColumn Header="Avg Range Rows"      Binding="{Binding AvgRangeRowsDisplay}"       Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- Tab: AI (Query Store top queries + Claude plan analysis) -->
            <TabItem Header="AI (QueryStore)">
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="8" Margin="0,8,0,0">

                    <!-- Panel: Query Store top queries -->
                    <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding AiVm}" x:DataType="vm:AiViewModel">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                <TextBlock Text="Query Store — Top Queries" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Metrics}"
                                          SelectedItem="{Binding SelectedMetric}"
                                          MinWidth="140" FontSize="11" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:QueryStoreMetricItem">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Loading…" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                                           IsVisible="{Binding IsLoading}"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Queries}"
                                      SelectedItem="{Binding SelectedQuery}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      FontSize="11">
                                <DataGrid.Styles>
                                    <Style Selector="DataGridCell.numeric TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGrid.Styles>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="24">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:QueryRow">
                                                <Grid>
                                                    <Ellipse Width="8" Height="8" Fill="#E04040"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             IsVisible="{Binding IsBusy}"/>
                                                    <Ellipse Width="8" Height="8" Fill="#33BB33"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             IsVisible="{Binding IsAnalyzed}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Id"        Binding="{Binding Info.QueryId}"                Width="Auto" CellStyleClasses="numeric"/>
                                    <DataGridTextColumn Header="Query"     Binding="{Binding Info.SqlSnippet}"             Width="*"/>
                                    <DataGridTextColumn Header="Execs"     Binding="{Binding Info.ExecutionsDisplay}"      Width="Auto" CellStyleClasses="numeric"/>
                                    <DataGridTextColumn Header="Avg ms"    Binding="{Binding Info.AvgDurationDisplay}"     Width="Auto" CellStyleClasses="numeric"/>
                                    <DataGridTextColumn Header="CPU ms"    Binding="{Binding Info.AvgCpuDisplay}"          Width="Auto" CellStyleClasses="numeric"/>
                                    <DataGridTextColumn Header="Reads"     Binding="{Binding Info.AvgLogicalReadsDisplay}" Width="Auto" CellStyleClasses="numeric"/>
                                    <DataGridTextColumn Header="Last Exec" Binding="{Binding Info.LastExecutionDisplay}"   Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Panel: query detail + AI analysis report -->
                    <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding AiVm}" x:DataType="vm:AiViewModel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="AI Plan Analysis" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    <ProgressBar IsIndeterminate="True" Width="110" Height="4" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsAnalyzing}"/>
                                    <TextBlock Text="{Binding ElapsedText}" Foreground="#CCCCCC" FontSize="11" FontFamily="Consolas,monospace"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ElapsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="#888" FontSize="11"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <SelectableTextBlock Text="{Binding RunErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               IsVisible="{Binding RunErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <Button Name="RunAnalyzeButton" Grid.Column="1" Content="Execute + Analyze"
                                        Command="{Binding OpenRunPopupCommand}"
                                        IsEnabled="{Binding CanRun}"/>
                                <Popup IsOpen="{Binding IsRunPopupOpen}" PlacementTarget="{Binding #RunAnalyzeButton}"
                                       Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
                                    <Border Background="#3C3C3C" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="8" Width="420">
                                            <TextBlock Text="Execute query and analyze actual plan" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                            <TextBlock Text="⚠ This runs the query below against the database for real — including any data modifications — and may take a long time. The actual plan is then saved and analyzed by Claude."
                                                       Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"/>
                                            <Border Background="#2D2D2D" CornerRadius="4" Padding="6" MaxHeight="200">
                                                <ScrollViewer>
                                                    <SelectableTextBlock Text="{Binding SelectedSqlText}" FontFamily="Consolas,monospace"
                                                                         Foreground="#CE9178" FontSize="11" TextWrapping="Wrap"/>
                                                </ScrollViewer>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Command="{Binding CancelRunCommand}"/>
                                                <Button Content="Run" Command="{Binding ConfirmRunCommand}" IsEnabled="{Binding !IsAnalyzing}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock DockPanel.Dock="Top" Text="SQL" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <Border DockPanel.Dock="Top" Background="#252525" CornerRadius="4" Padding="6" Height="150" Margin="0,0,0,8">
                                <ScrollViewer>
                                    <SelectableTextBlock Text="{Binding SelectedSqlText}" FontFamily="Consolas,monospace"
                                                         Foreground="#CE9178" FontSize="12" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>

                            <TextBlock DockPanel.Dock="Top" Text="AI Analysis Report" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <Border Background="#252525" CornerRadius="4" Padding="10,6">
                                <ScrollViewer>
                                    <controls:MarkdownViewer Markdown="{Binding AnalysisReport}"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- Tab: AI (Executionplans) — analyze .sqlplan files dropped in a folder -->
            <TabItem Header="AI (Executionplans)">
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="8" Margin="0,8,0,0">

                    <!-- Panel: plan folder + file list -->
                    <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding ExecutionPlansVm}" x:DataType="vm:ExecutionPlansViewModel">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                <TextBlock Text="Execution Plans" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Button Content="Refresh" FontSize="10" Padding="6,2" Command="{Binding RefreshCommand}"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top" Text="Plan folder" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox DockPanel.Dock="Top" Text="{Binding FolderPath}"
                                     Background="#3C3C3C" Foreground="White" FontSize="11" Margin="0,0,0,6"/>

                            <TextBlock DockPanel.Dock="Top" Text="Results folder" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox DockPanel.Dock="Top" Text="{Binding ResultsFolderPath}"
                                     Background="#3C3C3C" Foreground="White" FontSize="11" Margin="0,0,0,6"/>

                            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <ListBox ItemsSource="{Binding PlanFiles}"
                                     SelectedItem="{Binding SelectedPlanFile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanFileRow">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Grid Grid.Column="0" Width="16">
                                                <Ellipse Width="8" Height="8" Fill="#E04040"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         IsVisible="{Binding IsBusy}"/>
                                                <Ellipse Width="8" Height="8" Fill="#33BB33"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         IsVisible="{Binding IsAnalyzed}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Panel: plan file detail + AI analysis report -->
                    <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="4" Padding="8"
                            DataContext="{Binding ExecutionPlansVm}" x:DataType="vm:ExecutionPlansViewModel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="AI Plan Analysis" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    <ProgressBar IsIndeterminate="True" Width="110" Height="4" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsAnalyzing}"/>
                                    <TextBlock Text="{Binding ElapsedText}" Foreground="#CCCCCC" FontSize="11" FontFamily="Consolas,monospace"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ElapsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="#888" FontSize="11"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <SelectableTextBlock Text="{Binding RunErrorMessage}" Foreground="#FF6B6B" FontSize="11"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               IsVisible="{Binding RunErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Analyze"
                                        Command="{Binding AnalyzeCommand}"
                                        IsEnabled="{Binding CanAnalyze}"/>
                            </Grid>

                            <TextBlock DockPanel.Dock="Top" Text="Plan File" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPlanFilePath}"
                                       FontFamily="Consolas,monospace" Foreground="#CE9178" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock DockPanel.Dock="Top" Text="AI Analysis Report" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                            <Border Background="#252525" CornerRadius="4" Padding="10,6">
                                <ScrollViewer>
                                    <controls:MarkdownViewer Markdown="{Binding AnalysisReport}"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
